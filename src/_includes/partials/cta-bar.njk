<div class="cta-bar">
  <a class="btn btn--primary" href="{{ site.phone.href }}" data-track="call" data-track-location="barra-movil"
    ><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-phone" /></svg>Llamar</a
  >
  <a
    class="btn btn--outline"
    href="{{ site.whatsapp }}"
    data-track="whatsapp"
    data-track-location="barra-movil"
    target="_blank"
    rel="noopener"
    ><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-whatsapp" /></svg>WhatsApp</a
  >
  <a
    class="btn btn--outline btn--icon"
    href="{{ site.maps.directions }}"
    data-track="directions"
    data-track-location="barra-movil"
    target="_blank"
    rel="noopener"
    aria-label="Cómo llegar"
    ><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-map-pin" /></svg
  ></a>
</div>
