<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoRepair",
        "@id": "https://www.resortesfiebig.cl/#taller",
        "name": "Resortes Fiebig",
        "legalName": "Resortes Fiebig Limitada",
        "taxID": "78.486.010-8",
        "url": "https://www.resortesfiebig.cl/",
        "logo": "https://www.resortesfiebig.cl/assets/apple-touch-icon.png",
        "image": "https://www.resortesfiebig.cl/assets/og.png",
        "telephone": {{ site.phone.e164 | jsonLd | safe }},
        "email": {{ site.email | jsonLd | safe }},
        "foundingDate": "1994",
        "sameAs": ["https://www.facebook.com/resortes.fiebig"],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "08:00",
            "closes": "12:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "14:00",
            "closes": "18:00"
          }
        ],
        "hasMap": {{ site.maps.search | jsonLd | safe }},
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ site.address.street | jsonLd | safe }},
          "addressLocality": {{ site.address.city | jsonLd | safe }},
          "addressRegion": {{ site.address.region | jsonLd | safe }},
          "postalCode": "5500617",
          "addressCountry": "CL"
        },
        "areaServed": [
          "Puerto Montt",
          "Puerto Varas",
          "Llanquihue",
          "Calbuco",
          "Chiloé",
          "Osorno",
          "Región de Los Lagos"
        ],
        "knowsAbout": [
          "Fabricación de paquetes de resortes",
          "Reparación de paquetes de resortes",
          "Hojas de resorte a medida",
          "Rearqueo de resortes",
          "Suspensión de camiones"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios del taller",
          "itemListElement": [
            {%- for item in services %}
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": {{ item.card | jsonLd | safe }},
                "url": {{ (site.url + "servicios/" + item.slug + "/") | jsonLd | safe }}
              }
            }{{ "," if not loop.last }}
            {%- endfor %}
          ]
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://www.resortesfiebig.cl/#sitio",
        "name": "Resortes Fiebig",
        "url": "https://www.resortesfiebig.cl/",
        "inLanguage": "es-CL",
        "publisher": { "@id": "https://www.resortesfiebig.cl/#taller" }
      }
    ]
  }
</script>
