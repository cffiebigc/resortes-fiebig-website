              >{{ site.email }}</a
            >
          </dd>
        </div>
      </dl>
      <div class="contact__actions">
        <a class="btn btn--primary" href="{{ site.phone.href }}" data-track="call" data-track-location="contacto"
          ><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-phone" /></svg>Llamar al {{ site.phone.display }}</a
        >
        <a
          class="btn btn--outline btn--outline-dark"
          href="{{ site.maps.directions }}"
          data-track="directions"
          data-track-location="contacto"
          target="_blank"
          rel="noopener"
          ><svg class="icon" aria-hidden="true" focusable="false"><use href="#icon-map-pin" /></svg>Cómo llegar</a
        >
      </div>
    </div>
    <div class="contact__map">
      <iframe
        title="Mapa: Resortes Fiebig, Génesis 39, Parque Industrial Recondo, Puerto Montt"
        src="{{ site.maps.embed }}"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
